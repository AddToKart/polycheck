# NestJS API endpoint reachable by the browser
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Disabled by default. Enable only when QR upload/manual entry is explicitly required.
NEXT_PUBLIC_ALLOW_QR_FALLBACKS=true
# Offline-first PWA (service worker + IndexedDB queue). Set "false" to disable.
NEXT_PUBLIC_PWA_OFFLINE=true
NEXT_PUBLIC_PRIVACY_NOTICE_VERSION=2026-09-05
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
