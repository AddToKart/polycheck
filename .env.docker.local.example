# Local Docker only. Copy this file to .env.docker.local and do not commit it.
POSTGRES_PASSWORD=polycheck_local_db_2026
BETTER_AUTH_SECRET=polycheck-local-better-auth-secret-2026
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_ALLOW_QR_FALLBACKS=true
SEED_PASSWORD=PolycheckLocal1!
MAX_PROOF_BYTES=5000000
STORAGE_DRIVER=local
BACKEND_PORT=4000
FRONTEND_PORT=3000
POSTGRES_PORT=55432
REDIS_PORT=6379
# everysec loses up to ~1 s of AOF writes on power loss; set `always` for zero
# loss at one fsync per write (measure the ingest throughput cost first).
# REDIS_AOF_FSYNC=everysec

# Relaxed for local development / E2E automation (production keeps strict defaults)
LOGIN_RATE_LIMIT=200
LOGIN_IP_RATE_LIMIT=1000
API_RATE_LIMIT=2000
API_RATE_WINDOW_SECONDS=60
KEY_PROVISION_RATE_LIMIT=200
KEY_PROVISION_RATE_WINDOW_SECONDS=3600
