NODE_ENV=development
PORT=4000
# Local development connects directly. Production must target PgBouncer and
# add pgbouncer=true while retaining explicit connection_limit/pool_timeout.
DATABASE_URL=postgresql://polycheck:<URL_ENCODED_PASSWORD>@localhost:5432/polycheck?schema=public&connection_limit=10&pool_timeout=10
# Migrations must always target PostgreSQL directly, never PgBouncer.
DIRECT_DATABASE_URL=postgresql://polycheck:<URL_ENCODED_PASSWORD>@localhost:5432/polycheck?schema=public&connection_limit=2&pool_timeout=30
REDIS_URL=redis://localhost:6379/0
BETTER_AUTH_SECRET=replace-with-a-separate-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=false
TRUST_PROXY_HOPS=1

# Head/registrar scoping: 'legacy' = by department (default), 'course' = by course.
# Flip to 'course' only after designees have their courses assigned (plan/course-scope-plan.md).
COURSE_SCOPE_MODE=legacy

# Account activation email. 'disabled' (default) sends nothing; 'log' prints the message to the
# server log (development only, rejected in production); 'resend' needs the key and sender below.
# The Resend free plan allows 100 emails/day (UTC), so MAIL_DAILY_CAP defaults to 100.
MAIL_DRIVER=disabled
# RESEND_API_KEY=
# MAIL_FROM=Polycheck <no-reply@polycheck.live>
# MAIL_REPLY_TO=
# Optional delivery/bounce receipts: create a webhook in Resend pointing at POST /api/webhooks/resend and paste its signing secret.
# RESEND_WEBHOOK_SECRET=
MAIL_RATE_PER_SECOND=2
MAIL_DAILY_CAP=100
ENABLE_API_DOCS=true
# Required in production. Generate independently from authentication secrets.
METRICS_TOKEN=replace-with-a-separate-32-byte-random-token
UPLOAD_DIR=uploads
MAX_PROOF_BYTES=5000000
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Seed tooling only; never reuse this value in production.
SEED_PASSWORD=replace-with-a-unique-12-character-password
ALLOW_PRODUCTION_SEED=false

# AI assistant (optional — leave blank to disable the assistant)
# OpenAI-compatible endpoint. A key may also be stored encrypted by a super admin in Institution Settings (env key remains a fallback).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_MESSAGES_PER_DAY=100

# Optional dedicated secret for encrypting the UI-stored AI API key (falls back to BETTER_AUTH_SECRET when empty)
AI_KEY_ENCRYPTION_SECRET=

# Optional Expo push access token (only needed when Expo push security is enabled)
EXPO_ACCESS_TOKEN=
