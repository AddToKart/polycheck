FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache openssl libc6-compat && corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY shared/package.json shared/package.json
COPY backend/package.json backend/package.json
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm config set fetch-timeout 300000 \
 && pnpm config set fetch-retries 10 \
 && pnpm install --ignore-scripts --frozen-lockfile --filter @polycheck/backend... --filter @polycheck/shared...
COPY shared shared
COPY backend backend
# Build steps invoke the toolchain .bin entries directly instead of going
# through `pnpm <filter> build`: pnpm's verifyDepsBeforeRun check can trigger
# an implicit reinstall mid-build whose root postinstall expects the repo's
# `scripts/` folder (not copied in this image), which failed as a
# context-free exit 1. Direct binaries are the same commands the package
# scripts run, with no lifecycle hooks, so this failure class disappears.
# Node heap caps keep the compilers under the host memory ceiling.
RUN echo "[dcc] start: arch=$(uname -m) node=$(node -v) pnpm=$(pnpm -v) mem=$(head -1 /proc/meminfo)" \
 && cd /app/shared \
 && ./node_modules/.bin/tsup \
 && echo "[dcc] shared build ok"
RUN cd /app/backend \
 && NODE_OPTIONS=--max-old-space-size=1024 DATABASE_URL=postgresql://build:build@localhost:5432/build \
    ./node_modules/.bin/prisma generate
RUN cd /app/backend \
 && NODE_OPTIONS=--max-old-space-size=1280 ./node_modules/.bin/nest build
RUN cd /app/backend \
 && NODE_OPTIONS=--max-old-space-size=1280 ./node_modules/.bin/tsc \
      --ignoreConfig \
      --outDir /app/backend/dist-seed \
      --module nodenext --moduleResolution nodenext \
      --target es2022 --esModuleInterop --skipLibCheck --resolveJsonModule \
      prisma/seed.ts prisma/backfills/ledger-backfill.ts src/prisma/client.ts

FROM node:22-alpine AS production-dependencies
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json shared/package.json
COPY backend/package.json backend/package.json
RUN --mount=type=cache,id=pnpm-production,target=/root/.local/share/pnpm/store \
    pnpm config set fetch-timeout 300000 \
 && pnpm config set fetch-retries 10 \
 && pnpm install --ignore-scripts --prod --frozen-lockfile --filter @polycheck/backend... --filter @polycheck/shared...

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN apk add --no-cache tini openssl libc6-compat \
 && rm -rf /usr/local/lib/node_modules/npm /opt/yarn-* /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && addgroup -S polycheck \
 && adduser -S polycheck -G polycheck
COPY --from=production-dependencies --chown=polycheck:polycheck /app/node_modules ./node_modules
COPY --from=production-dependencies --chown=polycheck:polycheck /app/backend/node_modules ./backend/node_modules
COPY --from=production-dependencies --chown=polycheck:polycheck /app/shared/node_modules ./shared/node_modules
COPY --from=build --chown=polycheck:polycheck /app/backend/dist ./backend/dist
COPY --from=build --chown=polycheck:polycheck /app/backend/dist-seed ./backend/dist-seed
COPY --from=build --chown=polycheck:polycheck /app/backend/prisma ./backend/prisma
COPY --from=build --chown=polycheck:polycheck /app/backend/prisma.config.ts ./backend/prisma.config.ts
COPY --from=build --chown=polycheck:polycheck /app/backend/src/generated ./backend/src/generated
COPY --from=build --chown=polycheck:polycheck /app/backend/src/prisma/client.ts ./backend/src/prisma/client.ts
COPY --from=build --chown=polycheck:polycheck /app/backend/package.json ./backend/package.json
COPY --from=build --chown=polycheck:polycheck /app/backend/tsconfig.json ./backend/tsconfig.json
COPY --from=build --chown=polycheck:polycheck /app/backend/docker-entrypoint.sh ./backend/docker-entrypoint.sh
COPY --from=build --chown=polycheck:polycheck /app/shared/dist ./shared/dist
COPY --from=build --chown=polycheck:polycheck /app/shared/package.json ./shared/package.json
RUN mkdir -p /app/backend/uploads && chown polycheck:polycheck /app/backend/uploads
USER polycheck
WORKDIR /app/backend
EXPOSE 4000
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["sh", "docker-entrypoint.sh"]
