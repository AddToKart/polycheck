FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache openssl libc6-compat && corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY shared/package.json shared/package.json
COPY services/ingest/package.json services/ingest/package.json
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm config set fetch-timeout 300000 \
 && pnpm config set fetch-retries 10 \
 && pnpm install --ignore-scripts --frozen-lockfile --filter @polycheck/ingest... --filter @polycheck/shared...
COPY shared shared
COPY services/ingest services/ingest
# Direct binaries, not `pnpm <filter> build`: pnpm's verifyDepsBeforeRun can
# trigger an implicit reinstall whose root postinstall expects the repo's
# `scripts/` folder, which is not copied into this image (same lesson as
# Dockerfile.backend).
RUN cd /app/shared && ./node_modules/.bin/tsup
RUN cd /app/services/ingest && ./node_modules/.bin/tsc -p tsconfig.json

FROM node:22-alpine AS production-dependencies
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY shared/package.json shared/package.json
COPY services/ingest/package.json services/ingest/package.json
RUN --mount=type=cache,id=pnpm-production,target=/root/.local/share/pnpm/store \
    pnpm config set fetch-timeout 300000 \
 && pnpm config set fetch-retries 10 \
 && pnpm install --ignore-scripts --prod --frozen-lockfile --filter @polycheck/ingest... --filter @polycheck/shared...

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN apk add --no-cache tini openssl libc6-compat \
 && rm -rf /usr/local/lib/node_modules/npm /opt/yarn-* /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg \
 && addgroup -S polycheck \
 && adduser -S polycheck -G polycheck
COPY --from=production-dependencies --chown=polycheck:polycheck /app/node_modules ./node_modules
COPY --from=production-dependencies --chown=polycheck:polycheck /app/services/ingest/node_modules ./services/ingest/node_modules
COPY --from=production-dependencies --chown=polycheck:polycheck /app/shared/node_modules ./shared/node_modules
COPY --from=production-dependencies --chown=polycheck:polycheck /app/shared/package.json ./shared/package.json
COPY --from=production-dependencies --chown=polycheck:polycheck /app/services/ingest/package.json ./services/ingest/package.json
COPY --from=build --chown=polycheck:polycheck /app/shared/dist ./shared/dist
COPY --from=build --chown=polycheck:polycheck /app/services/ingest/dist ./services/ingest/dist
USER polycheck
EXPOSE 4001
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "services/ingest/dist/index.js"]
