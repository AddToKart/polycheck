# Replace every placeholder. Keep the real file out of version control.
POSTGRES_PASSWORD=<LONG_RANDOM_DATABASE_PASSWORD>
RUNTIME_DATABASE_PASSWORD=<SEPARATE_RUNTIME_PASSWORD_AT_LEAST_24_CHARS>
MIGRATOR_DATABASE_PASSWORD=<SEPARATE_MIGRATOR_PASSWORD_AT_LEAST_24_CHARS>
BACKUP_DATABASE_PASSWORD=<SEPARATE_BACKUP_PASSWORD_AT_LEAST_24_CHARS>
REDIS_PASSWORD=<LONG_RANDOM_REDIS_PASSWORD>

# URL-encode passwords embedded in URLs. Runtime traffic uses PgBouncer in
# transaction mode; migrations bypass it and use a deliberately small pool.
DATABASE_URL=postgresql://polycheck_runtime:<URL_ENCODED_RUNTIME_PASSWORD>@pgbouncer:5432/polycheck?schema=public&pgbouncer=true&connection_limit=10&pool_timeout=10
DIRECT_DATABASE_URL=postgresql://polycheck_migrator:<URL_ENCODED_MIGRATOR_PASSWORD>@postgres:5432/polycheck?schema=public&connection_limit=2&pool_timeout=30
REDIS_URL=redis://:<URL_ENCODED_REDIS_PASSWORD>@redis:6379/0

BETTER_AUTH_SECRET=<SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
METRICS_TOKEN=<SEPARATE_RANDOM_METRICS_TOKEN_AT_LEAST_32_CHARACTERS>
BETTER_AUTH_URL=https://polycheck.example.edu
CORS_ORIGINS=https://polycheck.example.edu
FRONTEND_URL=https://polycheck.example.edu
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ALLOW_QR_FALLBACKS=false
NEXT_PUBLIC_SENTRY_DSN=<PUBLIC_WEB_SENTRY_DSN>
SENTRY_DSN=<SERVER_SENTRY_DSN>
SENTRY_ORG=<SENTRY_ORGANIZATION_SLUG>
SENTRY_PROJECT=<SENTRY_WEB_PROJECT_SLUG>
PRIVACY_NOTICE_VERSION=2026-09-05
PRIVACY_NOTICE_URL=https://polycheck.example.edu/privacy
AUDIT_LOG_RETENTION_DAYS=2555
DENIED_SCAN_RETENTION_DAYS=90
ALERTMANAGER_CONFIG_PATH=./deployment/monitoring/alertmanager.yml
TRUST_PROXY=true
# Host TLS proxy -> nginx -> backend. The outer proxy must replace, not append,
# any client-supplied X-Forwarded-For header.
TRUST_PROXY_HOPS=2
ENABLE_API_DOCS=false
MAX_PROOF_BYTES=5000000

STORAGE_DRIVER=s3
S3_BUCKET=<S3_BUCKET_NAME>
S3_REGION=<S3_REGION>
S3_ENDPOINT=<OPTIONAL_S3_COMPATIBLE_ENDPOINT>
S3_ACCESS_KEY_ID=<S3_ACCESS_KEY_OR_EMPTY_FOR_WORKLOAD_IDENTITY>
S3_SECRET_ACCESS_KEY=<S3_SECRET_KEY_OR_EMPTY_FOR_WORKLOAD_IDENTITY>
S3_FORCE_PATH_STYLE=false

# nginx binds loopback by default so a host-level TLS proxy can own 443.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
BACKEND_REPLICAS=3

# Pool sizes must be capacity-planned against PostgreSQL max_connections.
PGBOUNCER_MAX_CLIENT_CONN=2000
PGBOUNCER_DEFAULT_POOL_SIZE=50
PGBOUNCER_MIN_POOL_SIZE=10
PGBOUNCER_RESERVE_POOL_SIZE=10
PGBOUNCER_SERVER_IDLE_TIMEOUT=600

# Required prebuilt application images. Production validation accepts only
# immutable registry digest references; tags (including sha-<commit> tags) are
# retargetable and rejected. Copy the values from the deployment-images artifact.
BACKEND_IMAGE=ghcr.io/<owner>/<repo>/backend@sha256:<64_HEX_DIGEST>
FRONTEND_IMAGE=ghcr.io/<owner>/<repo>/frontend@sha256:<64_HEX_DIGEST>

# Existing host directories on a protected, durable filesystem. Pre-create
# both as uid/gid 70 with mode 0700; Compose deliberately will not create them.
POSTGRES_BACKUP_PATH=/srv/polycheck/backups
POSTGRES_WAL_ARCHIVE_PATH=/srv/polycheck/wal-archive
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_SECONDS=93600
BASE_BACKUP_INTERVAL_DAYS=7
BASE_BACKUP_RETENTION_DAYS=35
POSTGRES_ARCHIVE_TIMEOUT_SECONDS=300
PITR_MAX_WAL_AGE_SECONDS=900
# Safety bound for continuity verification (16 MiB per segment).
PITR_MAX_CHAIN_SEGMENTS=1000000
# Minimum free space (KB) the WAL archiver requires before copying a segment.
WAL_MIN_FREE_KB=524288
# Institution-approved objectives for the included physical-base-backup + WAL
# archive path. These are targets, not an HA guarantee.
PITR_RPO_MINUTES=5
PITR_RTO_MINUTES=240

# Per-container Compose limits. Adjust from observed production usage.
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0
POSTGRES_SHM_SIZE=256mb
PGBOUNCER_MEMORY_LIMIT=256m
PGBOUNCER_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=1g
REDIS_CPU_LIMIT=1.0
REDIS_MAXMEMORY=768mb
MIGRATION_MEMORY_LIMIT=512m
MIGRATION_CPU_LIMIT=1.0
BACKEND_MEMORY_LIMIT=768m
BACKEND_CPU_LIMIT=1.0
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=1.0
NGINX_MEMORY_LIMIT=256m
NGINX_CPU_LIMIT=1.0
PROMETHEUS_MEMORY_LIMIT=512m
PROMETHEUS_CPU_LIMIT=0.5
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_PORT=9090
ALERTMANAGER_MEMORY_LIMIT=256m
ALERTMANAGER_CPU_LIMIT=0.25
BACKUP_MEMORY_LIMIT=768m
BACKUP_CPU_LIMIT=1.0
RESTORE_DRILL_MEMORY_LIMIT=768m
RESTORE_DRILL_CPU_LIMIT=1.0
PITR_RESTORE_MEMORY_LIMIT=1g
PITR_RESTORE_CPU_LIMIT=1.0

# Encrypted repository in a different host/account failure domain. Initialize once.
RESTIC_REPOSITORY=s3:https://<OFFSITE_ENDPOINT>/<BUCKET>/polycheck
RESTIC_PASSWORD=<SEPARATE_ENCRYPTION_PASSWORD_AT_LEAST_24_CHARACTERS>
OFFSITE_ACCESS_KEY_ID=<SEPARATE_OFFSITE_ACCESS_KEY>
OFFSITE_SECRET_ACCESS_KEY=<SEPARATE_OFFSITE_SECRET_KEY>
OFFSITE_REGION=us-east-1
OFFSITE_INTERVAL_SECONDS=300
OFFSITE_MAX_AGE_SECONDS=900
