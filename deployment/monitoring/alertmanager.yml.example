global:
  resolve_timeout: 5m

route:
  receiver: polycheck-operations
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: polycheck-operations
    webhook_configs:
      - url: https://alerts.example.edu/replace-with-private-polycheck-webhook
        send_resolved: true
