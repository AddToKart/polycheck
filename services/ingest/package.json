{
  "name": "@polycheck/ingest",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify ingestion gateway: validates scans in-process, buffers in Redis Streams, drains to Postgres in ordered micro-batches.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@polycheck/shared": "workspace:*",
    "fastify": "^5.6.2",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
