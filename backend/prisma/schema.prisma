generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  super_admin
  teacher
  student
}

enum RegistrationStatus {
  pending
  approved
}

// Temporary self sign-up for data gathering. An account exists only after a
// super admin approves the request.
model RegistrationRequest {
  id             String             @id @default(cuid())
  role           UserRole
  fullName       String
  email          String
  studentId      String?
  program        String?
  yearLevel      Int?
  passwordHash   String?
  status         RegistrationStatus @default(pending)
  consentVersion String
  createdAt      DateTime           @default(now())
  reviewedAt     DateTime?
  reviewedBy     String?
  createdUserId  String?

  @@index([status, createdAt])
  @@index([studentId])
  @@index([email])
}

enum DayOfWeek {
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat
  Sun
}

enum AttendanceStatus {
  present
  late
  absent
  pending
  disputed
  excused
  incomplete
}

enum SessionMode {
  in_person
  online
}

enum SectionRoleType {
  president
  qac
}

enum ReportCategory {
  scanner_camera
  geofence_gps
  ui_display
  enrollment_roster
  account_login
  feedback_suggestion
}

enum ReportSeverity {
  low
  medium
  high
  critical
}

enum ReportStatus {
  open
  in_review
  resolved
  dismissed
}

enum ReferralStatus {
  generated
  acknowledged
  counseling_scheduled
  resolved
}

model User {
  id                String   @id @default(cuid())
  studentId         String?  @unique
  fullName          String
  email             String?  @unique
  password          String
  authEmail         String   @unique
  authEmailVerified Boolean  @default(true)
  role              UserRole
  program           String?
  yearLevel         Int?
  department        String?
  photoUrl          String?
  scope             String?
  teacherPublicKey  String?
  isActive          Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  // True from an activation-email import until the student sets their own password.
  // The stored password is random and never revealed; login is simply impossible meanwhile.
  activationPending  Boolean @default(false)
  authVersion       Int      @default(0)
  // Account governance: delegated teacher capabilities and mobile device binding.
  boundDeviceId             String?
  deviceBoundAt             DateTime?
  deviceCooldownUntil       DateTime?
  // Device exempt from the logout-armed cooldown (the device that logged out).
  cooldownDeviceId          String?
  canResetStudentPasswords  Boolean?
  canEmergencyUnbindDevices Boolean?
  // Concurrent administrative designations (teacher accounts only).
  isItCoordinator  Boolean @default(false)
  isDepartmentHead Boolean @default(false)
  isUserRegistrar  Boolean @default(false)
  // Course scope of head/registrar designees (catalog program codes). Ignored for
  // everyone else; managesAllCourses wins; an empty scope is fail-closed.
  managedCourses    String[] @default([])
  managesAllCourses Boolean  @default(false)
  contactEmail            String?
  contactPhone              String?
  privacyConsentVersion String?
  privacyConsentedAt     DateTime?
  // Version of the AI assistant terms this account accepted before using it.
  aiTermsVersion    String?
  aiTermsAcceptedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sections           Section[]
  enrollments        Enrollment[]
  attendanceRecords  AttendanceRecord[]
  sectionRoles       SectionRole[]
  sessionPermissions SessionPermission[]
  proofsOfClass      ProofOfClass[]
  createdSubjects    Subject[]           @relation("SubjectCreator")
  scanAttempts       ScanAttempt[]
  authAccounts       AuthAccount[]
  authSessions       AuthSession[]
  importBatches      ImportBatch[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  systemReports      SystemReport[]
  activationTokens   AccountActivationToken[]
  passwordResetTokens PasswordResetToken[]
  accountMails       AccountMail[]

  sectionRemovals         EnrollmentTombstone[] @relation("SectionRemovals")
  removedSectionEnrollments EnrollmentTombstone[] @relation("SectionBlockedStudent")

  atRiskReferralsGenerated  AtRiskReferral[] @relation("AtRiskReferralGenerator")
  atRiskReferralsAgainst    AtRiskReferral[] @relation("AtRiskReferralStudent")

  @@index([role])
  @@index([studentId])
  @@index([email])
  @@index([privacyConsentVersion])
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthSession {
  id         String   @id
  expiresAt  DateTime
  token      String   @unique
  createdAt  DateTime
  updatedAt  DateTime
  ipAddress  String?
  userAgent  String?
  userId     String
  generation Int      @default(0)
  // Installation/browser identity that holds this session. Nullable so legacy
  // rows (and clients that do not send a device id) never block another device.
  deviceId   String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, generation])
  @@index([userId, deviceId])
  @@index([expiresAt])
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@index([expiresAt])
}

model InstitutionSetting {
  key       String   @id
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  // Unique among active subjects only (partial index in the subject_archive migration).
  code        String
  description String?
  createdById String?
  createdBy   User?    @relation("SubjectCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  archivedAt       DateTime?
  archivedById     String?
  // When the archived subject's evidence was erased (90 days after archiving).
  evidencePurgedAt DateTime?

  sections Section[]

  @@index([createdById])
  @@index([archivedAt])
  @@index([code])
}

model Section {
  id                   String    @id @default(cuid())
  subjectId            String
  subject              Subject   @relation(fields: [subjectId], references: [id])
  section              String
  // Campus program/course short code (e.g. 'BSIT'). Optional for
  // legacy rows created before courses were captured; new web sections set it.
  course               String?
  room                 String
  semester             String
  teacherId            String
  teacher              User      @relation(fields: [teacherId], references: [id])
  enrollmentCode       String?   @unique
  enrollmentCodeExpiry DateTime?
  studentCount         Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  schedule           ScheduleDay[]
  enrollments        Enrollment[]
  sessions           Session[]
  sectionRoles       SectionRole[]
  sessionPermissions SessionPermission[]
  proofsOfClass      ProofOfClass[]
  attendanceRecords  AttendanceRecord[]
  enrollmentTombstones EnrollmentTombstone[]
  atRiskReferrals    AtRiskReferral[]

  @@unique([subjectId, section, semester, teacherId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([enrollmentCode])
  @@index([course])
}

// V3 anti-zombie: students removed by the instructor can only be re-admitted
// explicitly (teacher enrollment / bulk import), never by re-entering an
// enrollment code that has not expired yet.
model EnrollmentTombstone {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  studentId   String
  student     User     @relation("SectionBlockedStudent", fields: [studentId], references: [id], onDelete: Cascade)
  removedById String
  removedBy   User     @relation("SectionRemovals", fields: [removedById], references: [id], onDelete: Restrict)
  removedAt   DateTime @default(now())
  reason      String?

  @@unique([sectionId, studentId])
  @@index([studentId])
}

model ScheduleDay {
  id        String    @id @default(cuid())
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  day       DayOfWeek
  startTime String
  endTime   String
  room      String?

  @@index([sectionId])
}

model Enrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id])
  enrolledAt DateTime @default(now())

  @@unique([studentId, sectionId])
  @@index([sectionId])
  @@index([studentId])
}

model Session {
  id                   String    @id @default(cuid())
  sectionId            String
  section              Section   @relation(fields: [sectionId], references: [id])
  teacherId            String
  subjectName          String
  date                 String
  startTime            String
  endTime              String
  room                 String?
  mode                 SessionMode @default(in_person)
  qrValidityMinutes    Int
  gracePeriodMinutes   Int
  // Hybrid online checkpoints (in_person sessions leave these null and keep
  // using the legacy single-QR columns below).
  startQrValiditySeconds Int?
  startGraceMinutes      Int?
  endQrValiditySeconds   Int?
  endGraceMinutes        Int       @default(0)
  startQrToken           String?
  startTokenExpiresAt    DateTime?
  startQrGeneratedAt     DateTime?
  startPinHash           String?
  endQrToken             String?
  endTokenExpiresAt      DateTime?
  endQrGeneratedAt       DateTime?
  endPinHash             String?
  autoEndAt              DateTime?
  // A section president may run the sessions they create. `hostPublicKey` is
  // the server-held signing key of that one session; it verifies scans only
  // once `hostStartedAt` is set. Every other session uses the professor's key.
  hostStudentId        String?
  hostPublicKey        String?
  hostStartedAt        DateTime?
  geofenceLatitude     Float?
  geofenceLongitude    Float?
  geofenceRadiusMeters Int?
  isActive             Boolean   @default(false)
  endedAt              DateTime?
  qrToken              String?
  qrTokenExpiresAt     DateTime?
  qrGeneratedAt        DateTime?
  isRescheduled        Boolean   @default(false)
  rescheduledFromDate  String?
  originalScheduleTime String?
  originalRoom         String?
  createdAt            DateTime  @default(now())

  attendanceRecords AttendanceRecord[]
  scanAttempts      ScanAttempt[]
  proofsOfClass     ProofOfClass[]

  @@index([sectionId])
  @@index([teacherId])
  @@index([date])
  @@index([isActive])
  @@index([autoEndAt])
  @@index([teacherId, date])
  @@index([sectionId, date])
  @@unique([sectionId, date, startTime, endTime])
}

model ScanAttempt {
  id                       String            @id @default(cuid())
  sessionId                String
  session                  Session           @relation(fields: [sessionId], references: [id])
  studentId                String
  student                  User              @relation(fields: [studentId], references: [id])
  clientAttemptId          String?
  timestamp                DateTime
  clientScannedAt          DateTime?
  receivedAt               DateTime          @default(now())
  locationCapturedAt       DateTime?
  latitude                 Float?
  longitude                Float?
  accuracyMeters           Float?
  mocked                   Boolean?
  inputChannel             String?
  checkpoint               String?
  pinVerified              Boolean?
  deviceId                 String?
  offline                  Boolean?          @default(false)
  distanceMeters           Float?
  geofenceRadiusMeters     Int?
  riskSignals              Json?
  outcome                  String
  reason                   String?
  message                  String?
  tokenHash                String?
  createdAt                DateTime          @default(now())
  acceptedAttendanceRecord AttendanceRecord? @relation("AcceptedScanAttempt")
  acceptedCheckInRecord    AttendanceRecord? @relation("AcceptedCheckInAttempt")
  acceptedCheckOutRecord   AttendanceRecord? @relation("AcceptedCheckOutAttempt")

  @@unique([studentId, clientAttemptId])
  @@index([sessionId, timestamp])
  @@index([studentId, timestamp])
  @@index([receivedAt])
  @@index([createdAt])
  @@index([studentId, deviceId, receivedAt])
  @@index([deviceId])
}

model AttendanceRecord {
  id                    String           @id @default(cuid())
  sessionId             String
  session               Session          @relation(fields: [sessionId], references: [id])
  sectionId             String
  section               Section          @relation(fields: [sectionId], references: [id])
  studentId             String
  student               User             @relation(fields: [studentId], references: [id])
  studentName           String
  studentProgram        String?
  timestamp             DateTime
  status                AttendanceStatus
  latitude              Float?
  longitude             Float?
  checkInTime           DateTime?
  checkInStatus         AttendanceStatus?
  checkOutTime          DateTime?
  checkOutStatus        AttendanceStatus?
  checkInToken          String?
  checkOutToken         String?
  deviceId              String?
  tokenSnapshot         String?
  isSynced              Boolean          @default(false)
  syncedAt              DateTime?
  // Per-session hash chain (WF-LD11). The chain write happens inside the same
  // transaction that commits the record; historical rows are backfilled by the
  // prisma/backfills/ledger-backfill.ts script (per-session, (timestamp, id)
  // order). Hash math and canonical byte string live in shared/src/utils/ledger.ts.
  prevHash              String?
  recordHash            String?
  salt                  String?
  disputeReason         String?
  disputeDescription    String?
  // Pre-dispute status stamped when the student files. Rejecting the dispute
  // restores it; legacy rows stay NULL and fall back to `absent` (DD-B2).
  disputePreviousStatus AttendanceStatus?
  disputeResolved       Boolean          @default(false)
  manuallySet           Boolean          @default(false)
  notes                 String?
  excuseStatus          String?
  excuseReason          String?
  excuseDescription     String?
  excuseEvidencePath    String?
  excuseReviewedBy      String?
  excuseReviewedAt      DateTime?
  excuseReviewNote      String?
  acceptedScanAttemptId String?          @unique
  acceptedScanAttempt   ScanAttempt?     @relation("AcceptedScanAttempt", fields: [acceptedScanAttemptId], references: [id], onDelete: Restrict)
  checkInAttemptId      String?          @unique
  checkInAttempt        ScanAttempt?     @relation("AcceptedCheckInAttempt", fields: [checkInAttemptId], references: [id], onDelete: Restrict)
  checkOutAttemptId     String?          @unique
  checkOutAttempt       ScanAttempt?     @relation("AcceptedCheckOutAttempt", fields: [checkOutAttemptId], references: [id], onDelete: Restrict)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([sessionId, timestamp])
  @@index([studentId])
  @@index([sectionId])
  @@index([status])
  @@index([isSynced])
  @@index([sessionId, status])
  @@index([sectionId, status])
  @@index([studentId, sectionId, timestamp])
  @@index([excuseStatus])
}

model SectionRole {
  id          String          @id @default(cuid())
  sectionId   String
  section     Section         @relation(fields: [sectionId], references: [id])
  studentId   String
  student     User            @relation(fields: [studentId], references: [id])
  studentName String
  role        SectionRoleType
  grantedBy   String
  grantedAt   DateTime        @default(now())

  @@unique([sectionId, studentId, role])
  @@index([sectionId])
  @@index([studentId])
}

model SessionPermission {
  id        String   @id @default(cuid())
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id])
  studentId String
  student   User     @relation(fields: [studentId], references: [id])
  grantedBy String
  grantedAt DateTime @default(now())
  expiresAt DateTime
  isActive  Boolean  @default(true)
  // How many sessions this grant lets the president create.
  sessionLimit Int       @default(1)
  sessionsUsed Int       @default(0)
  revokedAt    DateTime?

  @@unique([sectionId, studentId])
  @@index([sectionId])
  @@index([studentId])
  @@index([isActive, expiresAt])
}

model ProofOfClass {
  id                    String   @id @default(cuid())
  sectionId             String
  section               Section  @relation(fields: [sectionId], references: [id])
  sessionId             String
  session               Session  @relation(fields: [sessionId], references: [id])
  uploadedBy            String
  student               User     @relation(fields: [uploadedBy], references: [id])
  uploadedByStudentName String
  photoUrl              String
  uploadedAt            DateTime @default(now())
  description           String?

  @@index([sessionId])
  @@index([sectionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

// Single-use email activation link. Only the sha256 of the raw token is stored;
// the raw token exists in the email and in the student's browser fragment only.
model AccountActivationToken {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  // Wrong student-number attempts against this token; the fifth revokes it.
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Single-use, hashed, short-lived link for the self-service "forgot password" flow. Only sha256(token) is
// stored; the raw value exists in the email and the link fragment only.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// Mail outbox + delivery status. No message body or token is stored; the raw
// activation token is generated by the worker at send time. Status values are
// plain strings (queued | sending | sent | failed | bounced) so clients never
// switch on a new wire enum.
model AccountMail {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  status     String    @default("queued")
  attempts   Int       @default(0)
  providerId String?
  errorCode  String?
  queuedAt   DateTime  @default(now())
  sentAt     DateTime?
  batchId    String?

  @@index([status, queuedAt])
  @@index([userId, queuedAt])
  @@index([batchId])
}

// Shared column-mapping profile for master-list imports (headers and column positions only, never student data).
model ImportMappingProfile {
  id          String   @id @default(cuid())
  mode        String
  fingerprint String
  headers     String[] @default([])
  mapping     Json
  uses        Int      @default(1)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([mode, fingerprint])
  @@index([updatedAt])
}

model ImportBatch {
  id          String   @id @default(cuid())
  kind        String
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  department  String?
  total       Int
  created     Int
  updated     Int
  skipped     Int
  failed      Int
  summary     Json?
  rowChecksum String
  createdAt   DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([createdAt])
}

model SystemReport {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userRole      UserRole
  category      ReportCategory
  severity      ReportSeverity @default(medium)
  title         String
  description   String
  status        ReportStatus   @default(open)
  deviceInfo    String?
  appVersion    String?
  route         String?
  networkType   String?
  screenshotUrl String?
  adminNotes    String?
  resolvedAt    DateTime?
  resolvedBy    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([category])
  @@index([severity])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   String
  token      String   @unique
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

// F5 (WF-LD7): CHED CMO No. 40 notice-of-impending-drop referral slip.
// A slip is only generatable while the deterministic at-risk engine classifies
// the student `below_threshold` or `at_risk`; at most one ACTIVE referral
// (status != resolved) may exist per (student, section).
model AtRiskReferral {
  id            String         @id @default(cuid())
  studentId     String
  student       User           @relation("AtRiskReferralStudent", fields: [studentId], references: [id], onDelete: Cascade)
  sectionId     String
  section       Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  generatedById String
  generatedBy   User           @relation("AtRiskReferralGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  status        ReferralStatus @default(generated)
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([sectionId])
  @@index([status])
  @@index([studentId])
}
