# NestJS API endpoint reachable by the browser
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Disabled by default. Enable only when QR upload/manual entry is explicitly required.
NEXT_PUBLIC_ALLOW_QR_FALLBACKS=true
# F7 outage-simulator demo surface (cockpit + dashboard). Dev/demo only —
# keep "false" in production; local compose passes "true" explicitly.
NEXT_PUBLIC_ENABLE_OUTAGE_SIMULATOR=false
# Offline-first PWA (service worker + IndexedDB queue). Set "false" to disable.
NEXT_PUBLIC_PWA_OFFLINE=true
# Site that serves the Privacy Policy and Terms (default https://polycheck.live)
NEXT_PUBLIC_LEGAL_SITE_URL=https://polycheck.live
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
